# Nginx Configuration Template
# KKL Informatika UPGRIS 2026
# Location: /etc/nginx/sites-available/kkl-2026

server {
    listen 80;
    listen [::]:80;
    server_name kkl-informatika.upgris.ac.id www.kkl-informatika.upgris.ac.id;
    
    # Redirect HTTP to HTTPS
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name kkl-informatika.upgris.ac.id www.kkl-informatika.upgris.ac.id;
    
    # SSL Certificates (Let''s Encrypt)
    ssl_certificate /etc/letsencrypt/live/kkl-informatika.upgris.ac.id/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kkl-informatika.upgris.ac.id/privkey.pem;
    
    # SSL Configuration
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    
    # Security Headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    
    # Root directory
    root /var/www/kkl-2026;
    index index.php index.html;
    
    # Logging
    access_log /var/log/nginx/kkl-2026-access.log;
    error_log /var/log/nginx/kkl-2026-error.log;
    
    # Block access to sensitive files
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
    
    location ~ /\.secure {
        deny all;
        access_log off;
        log_not_found off;
    }
    
    location ~ \.(sql|env|bak|log)$ {
        deny all;
        access_log off;
        log_not_found off;
    }
    
    # PHP-FPM
    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_pass unix:/run/php/php8.0-fpm.sock;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
    }
    
    # Static files caching
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|webp|woff|woff2|ttf|eot)$ {
        expires 365d;
        add_header Cache-Control "public, immutable";
    }
    
    # Disable directory listing
    autoindex off;
    
    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml+rss;
}
