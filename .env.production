###############################################################
# KKL Informatika UPGRIS 2026 - Environment Configuration
# Production Server Setup
# 
# IMPORTANT: Change all values sesuai dengan server Anda!
# DO NOT commit this file to git!
###############################################################

# ===== APPLICATION =====
APP_ENV=production
APP_URL=https://kkl-informatika.upgris.ac.id
APP_NAME="KKL Informatika UPGRIS 2026"
APP_TIMEZONE=Asia/Jakarta

# ===== DATABASE =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kkl_upgris_2026
DB_USER=kkl_user
DB_PASS=your_secure_password_here

# ===== SESSION =====
SESSION_TIMEOUT=1800
SESSION_NAME=kkl_session
SESSION_SECURE=true
SESSION_HTTPONLY=true
SESSION_SAMESITE=Lax

# ===== ADMIN SECURITY =====
ADMIN_LOGIN_ATTEMPTS=5
ADMIN_LOCKOUT_TIME=900
ADMIN_PASSWORD_MIN_LENGTH=8
ADMIN_PASSWORD_REQUIRE_SPECIAL=true

# ===== FEEDBACK =====
FEEDBACK_RATE_LIMIT=3
FEEDBACK_RATE_LIMIT_WINDOW=3600
FEEDBACK_REQUIRE_APPROVAL=true

# ===== FILE UPLOADS =====
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,gif

# ===== LOGGING =====
LOG_LEVEL=error
LOG_DIR=logs
LOG_MAX_FILES=30

# ===== SECURITY HEADERS =====
ENABLE_HSTS=true
HSTS_MAX_AGE=31536000
ENABLE_CSP=true
ENABLE_X_FRAME_OPTIONS=true

# ===== EMAIL (Optional) =====
# MAIL_DRIVER=smtp
# MAIL_HOST=smtp.mailtrap.io
# MAIL_PORT=465
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=noreply@kkl-informatika.upgris.ac.id

# ===== MONITORING (Optional) =====
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/xxxxx
# LOG_SLACK_WEBHOOK=

###############################################################
# IMPORTANT SECURITY NOTES:
#
# 1. Change DB_PASS to something strong!
#    - Min 12 characters
#    - Mix uppercase, lowercase, numbers, special chars
#
# 2. Change APP_URL to your actual domain
#
# 3. Generate admin password with:
#    php generate_password.php
#
# 4. Never commit this file to git
#    (Already in .gitignore)
#
# 5. Set proper file permissions:
#    chmod 600 .env
#    chown www-data:www-data .env
#
# 6. On production, disable debug mode:
#    APP_ENV=production (NOT development)
#
###############################################################
